rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{id} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }
    match /announcements/{id} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }
  }
}
