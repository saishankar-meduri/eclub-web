NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# V2 — server only (Firebase console > Project settings > Service accounts > Generate new private key)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# only for `npm run seed:admin`
SUPERADMIN_EMAIL=

# V3 — event image uploads (Cloudinary dashboard > Settings > API Keys). Server only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# V4 — shortlist emails over SMTP. Server only. If SMTP_HOST is empty, emails are skipped (logged), shortlisting still works.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="E-Club <noreply@example.com>"
NEXT_PUBLIC_SITE_URL=https://eclub-web.vercel.app

# V4 — shared rate limiting for /api/status (Upstash Redis REST, free tier). Optional: falls back to per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
